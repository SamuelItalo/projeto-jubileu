# Copie este arquivo para .env e preencha somente no seu computador.
# Nunca envie a chave por chat, nem a registre em código ou documentação.
OPENAI_API_KEY=sua_chave_aqui

# Infraestrutura local
POSTGRES_DB=jubileu
POSTGRES_USER=jubileu
POSTGRES_PASSWORD=troque_por_uma_senha_local

# Desenvolvimento local somente. Mantenha como false quando definir a senha inicial.
APP_ENVIRONMENT=development
APP_ALLOW_INSECURE_TEST_AUTH=false
VOSK_MODEL_PATH=/models/vosk-model-small-pt-0.3
# `deterministic` não usa LLM. `hybrid_ollama` usa Ollama local apenas como alternativa.
COMMAND_INTERPRETER=deterministic
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b-instruct

# Obrigatória em produção. Enquanto ausente, use a flag de teste acima somente no computador local.
APP_INITIAL_USERNAME=Samuel
APP_INITIAL_PASSWORD=
